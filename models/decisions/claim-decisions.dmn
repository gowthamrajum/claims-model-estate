<?xml version="1.0" encoding="UTF-8"?>
<!-- A decision chain three deep. triage-severity depends on two decisions, one of which
     depends on a third, so the graph continues well past the BPMN layer. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="Defs_claim_decisions" name="Claim decisions"
             namespace="http://acme.com/dmn/claims">

  <decision id="intake-eligibility" name="Intake eligibility">
    <informationRequirement id="ir_elig_policy">
      <requiredDecision href="#policy-status" />
    </informationRequirement>
    <decisionTable id="dt_elig" hitPolicy="UNIQUE">
      <input id="in_elig_policy" label="Policy standing">
        <inputExpression id="ie_elig_policy" typeRef="string">policyStatus</inputExpression>
      </input>
      <input id="in_elig_date" label="Incident date">
        <inputExpression id="ie_elig_date" typeRef="date">incidentDate</inputExpression>
      </input>
      <output id="out_elig" name="eligibility" label="Eligible" typeRef="string" />
    </decisionTable>
  </decision>

  <decision id="triage-severity" name="Triage severity">
    <informationRequirement id="ir_sev_fraud">
      <requiredDecision href="#fraud-score" />
    </informationRequirement>
    <informationRequirement id="ir_sev_policy">
      <requiredDecision href="#policy-status" />
    </informationRequirement>
    <decisionTable id="dt_sev" hitPolicy="FIRST">
      <input id="in_sev_fraud" label="Fraud score">
        <inputExpression id="ie_sev_fraud" typeRef="number">fraudScore</inputExpression>
      </input>
      <input id="in_sev_amount" label="Amount claimed">
        <inputExpression id="ie_sev_amount" typeRef="number">claimAmount</inputExpression>
      </input>
      <output id="out_sev" name="severity" label="Severity" typeRef="string" />
    </decisionTable>
  </decision>

  <decision id="fraud-score" name="Fraud score">
    <informationRequirement id="ir_fraud_history">
      <requiredDecision href="#claim-history" />
    </informationRequirement>
    <decisionTable id="dt_fraud" hitPolicy="COLLECT">
      <input id="in_fraud_history" label="Prior claims">
        <inputExpression id="ie_fraud_history" typeRef="number">priorClaimCount</inputExpression>
      </input>
      <output id="out_fraud" name="fraudScore" label="Fraud score" typeRef="number" />
    </decisionTable>
  </decision>

  <decision id="policy-status" name="Policy status">
    <decisionTable id="dt_policy" hitPolicy="UNIQUE">
      <input id="in_policy_number" label="Policy number">
        <inputExpression id="ie_policy_number" typeRef="string">policyNumber</inputExpression>
      </input>
      <output id="out_policy" name="policyStatus" label="Standing" typeRef="string" />
    </decisionTable>
  </decision>

  <decision id="claim-history" name="Claim history">
    <decisionTable id="dt_history" hitPolicy="UNIQUE">
      <input id="in_history_policy" label="Policy number">
        <inputExpression id="ie_history_policy" typeRef="string">policyNumber</inputExpression>
      </input>
      <output id="out_history" name="priorClaimCount" label="Prior claims" typeRef="number" />
    </decisionTable>
  </decision>
</definitions>
