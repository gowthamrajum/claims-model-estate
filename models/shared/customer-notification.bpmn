<?xml version="1.0" encoding="UTF-8"?>
<!-- A shared leaf: reached from both roots. Changing this one touches everything. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Defs_notify" targetNamespace="http://acme.com/claims"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="customer-notification" name="Customer Notification" isExecutable="true">
    <bpmn:startEvent id="Start_Notify">
      <bpmn:outgoing>N1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="N1" sourceRef="Start_Notify" targetRef="Service_Send" />
    <bpmn:serviceTask id="Service_Send" name="Send notification"
                      camunda:type="external" camunda:topic="notification-send">
      <bpmn:incoming>N1</bpmn:incoming>
      <bpmn:outgoing>N2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="N2" sourceRef="Service_Send" targetRef="End_Notify" />
    <bpmn:endEvent id="End_Notify" name="Sent">
      <bpmn:incoming>N2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DI_diagram_customer-notification">
    <bpmndi:BPMNPlane id="DI_plane_customer-notification" bpmnElement="customer-notification">
      <bpmndi:BPMNShape id="DI_End_Notify" bpmnElement="End_Notify">
        <dc:Bounds x="316" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Service_Send" bpmnElement="Service_Send">
        <dc:Bounds x="156" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Notify" bpmnElement="Start_Notify">
        <dc:Bounds x="60" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_N1" bpmnElement="N1">
        <di:waypoint x="96" y="78" />
        <di:waypoint x="126" y="78" />
        <di:waypoint x="126" y="100" />
        <di:waypoint x="156" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_N2" bpmnElement="N2">
        <di:waypoint x="256" y="100" />
        <di:waypoint x="286" y="100" />
        <di:waypoint x="286" y="78" />
        <di:waypoint x="316" y="78" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
