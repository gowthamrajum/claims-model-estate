<?xml version="1.0" encoding="UTF-8"?>
<!-- A third entry point nobody calls, pointing at a process that was retired years ago.
     The kind of thing an estate accumulates and nobody notices. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Defs_legacy" targetNamespace="http://acme.com/claims"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="legacy-reconciliation" name="Legacy Reconciliation" isExecutable="true">
    <bpmn:startEvent id="Start_Legacy"><bpmn:outgoing>L1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="L1" sourceRef="Start_Legacy" targetRef="CallActivity_Retired" />
    <bpmn:callActivity id="CallActivity_Retired" name="Clearing house run"
                       calledElement="retired-clearing-house">
      <bpmn:incoming>L1</bpmn:incoming>
      <bpmn:outgoing>L2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="L2" sourceRef="CallActivity_Retired" targetRef="End_Legacy" />
    <bpmn:endEvent id="End_Legacy"><bpmn:incoming>L2</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DI_diagram_legacy-reconciliation">
    <bpmndi:BPMNPlane id="DI_plane_legacy-reconciliation" bpmnElement="legacy-reconciliation">
      <bpmndi:BPMNShape id="DI_CallActivity_Retired" bpmnElement="CallActivity_Retired">
        <dc:Bounds x="156" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_Legacy" bpmnElement="End_Legacy">
        <dc:Bounds x="316" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Legacy" bpmnElement="Start_Legacy">
        <dc:Bounds x="60" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_L1" bpmnElement="L1">
        <di:waypoint x="96" y="78" />
        <di:waypoint x="126" y="78" />
        <di:waypoint x="126" y="100" />
        <di:waypoint x="156" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_L2" bpmnElement="L2">
        <di:waypoint x="256" y="100" />
        <di:waypoint x="286" y="100" />
        <di:waypoint x="286" y="78" />
        <di:waypoint x="316" y="78" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
