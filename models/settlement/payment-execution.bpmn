<?xml version="1.0" encoding="UTF-8"?>
<!-- Reaches fraud-investigation a second time, from a different root, and picks its payment
     provider by expression, so that target cannot be resolved without running it. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Defs_pay" targetNamespace="http://acme.com/claims"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="payment-execution" name="Payment Execution" isExecutable="true">
    <bpmn:startEvent id="Start_Pay">
      <bpmn:outgoing>P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="P1" sourceRef="Start_Pay" targetRef="CallActivity_ReFraud" />

    <bpmn:callActivity id="CallActivity_ReFraud" name="Re-check fraud before payout"
                       calledElement="fraud-investigation"
                       camunda:calledElementBinding="latest">
      <bpmn:incoming>P1</bpmn:incoming>
      <bpmn:outgoing>P2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="P2" sourceRef="CallActivity_ReFraud" targetRef="CallActivity_Provider" />

    <!-- Which provider process runs is decided at runtime. -->
    <bpmn:callActivity id="CallActivity_Provider" name="Call payment provider"
                       calledElement="${paymentProviderProcess}">
      <bpmn:incoming>P2</bpmn:incoming>
      <bpmn:outgoing>P3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="P3" sourceRef="CallActivity_Provider" targetRef="End_Pay" />

    <bpmn:endEvent id="End_Pay" name="Paid">
      <bpmn:incoming>P3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DI_diagram_payment-execution">
    <bpmndi:BPMNPlane id="DI_plane_payment-execution" bpmnElement="payment-execution">
      <bpmndi:BPMNShape id="DI_CallActivity_Provider" bpmnElement="CallActivity_Provider">
        <dc:Bounds x="316" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CallActivity_ReFraud" bpmnElement="CallActivity_ReFraud">
        <dc:Bounds x="156" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_Pay" bpmnElement="End_Pay">
        <dc:Bounds x="476" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Pay" bpmnElement="Start_Pay">
        <dc:Bounds x="60" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_P1" bpmnElement="P1">
        <di:waypoint x="96" y="78" />
        <di:waypoint x="126" y="78" />
        <di:waypoint x="126" y="100" />
        <di:waypoint x="156" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_P2" bpmnElement="P2">
        <di:waypoint x="256" y="100" />
        <di:waypoint x="316" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_P3" bpmnElement="P3">
        <di:waypoint x="416" y="100" />
        <di:waypoint x="446" y="100" />
        <di:waypoint x="446" y="78" />
        <di:waypoint x="476" y="78" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
