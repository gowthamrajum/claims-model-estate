<?xml version="1.0" encoding="UTF-8"?>
<!-- A second entry point. Shares customer-notification with claim-triage, so the graph
     converges rather than being a clean tree. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Defs_settle" targetNamespace="http://acme.com/claims"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="settlement" name="Settlement" isExecutable="true">
    <bpmn:startEvent id="Start_Settle">
      <bpmn:outgoing>SE1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SE1" sourceRef="Start_Settle" targetRef="Rule_Authority" />

    <bpmn:businessRuleTask id="Rule_Authority" name="Settlement authority"
                           camunda:decisionRef="settlement-authority"
                           camunda:decisionRefBinding="version"
                           camunda:decisionRefVersion="2"
                           camunda:resultVariable="authority">
      <bpmn:incoming>SE1</bpmn:incoming>
      <bpmn:outgoing>SE2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="SE2" sourceRef="Rule_Authority" targetRef="CallActivity_Pay" />

    <bpmn:callActivity id="CallActivity_Pay" name="Execute payment"
                       calledElement="payment-execution">
      <bpmn:incoming>SE2</bpmn:incoming>
      <bpmn:outgoing>SE3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="SE3" sourceRef="CallActivity_Pay" targetRef="CallActivity_NotifySettle" />

    <!-- Same callee as claim-triage reaches, from a different branch of the estate. -->
    <bpmn:callActivity id="CallActivity_NotifySettle" name="Notify claimant of settlement"
                       calledElement="customer-notification">
      <bpmn:incoming>SE3</bpmn:incoming>
      <bpmn:outgoing>SE4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="SE4" sourceRef="CallActivity_NotifySettle" targetRef="End_Settle" />

    <bpmn:endEvent id="End_Settle" name="Settled">
      <bpmn:incoming>SE4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DI_diagram_settlement">
    <bpmndi:BPMNPlane id="DI_plane_settlement" bpmnElement="settlement">
      <bpmndi:BPMNShape id="DI_CallActivity_NotifySettle" bpmnElement="CallActivity_NotifySettle">
        <dc:Bounds x="476" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CallActivity_Pay" bpmnElement="CallActivity_Pay">
        <dc:Bounds x="316" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_Settle" bpmnElement="End_Settle">
        <dc:Bounds x="636" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Rule_Authority" bpmnElement="Rule_Authority">
        <dc:Bounds x="156" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Settle" bpmnElement="Start_Settle">
        <dc:Bounds x="60" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_SE1" bpmnElement="SE1">
        <di:waypoint x="96" y="78" />
        <di:waypoint x="126" y="78" />
        <di:waypoint x="126" y="100" />
        <di:waypoint x="156" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SE2" bpmnElement="SE2">
        <di:waypoint x="256" y="100" />
        <di:waypoint x="316" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SE3" bpmnElement="SE3">
        <di:waypoint x="416" y="100" />
        <di:waypoint x="476" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SE4" bpmnElement="SE4">
        <di:waypoint x="576" y="100" />
        <di:waypoint x="606" y="100" />
        <di:waypoint x="606" y="78" />
        <di:waypoint x="636" y="78" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
