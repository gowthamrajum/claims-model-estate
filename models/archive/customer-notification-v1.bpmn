<?xml version="1.0" encoding="UTF-8"?>
<!-- An archived copy that kept the original process key. Which one the engine runs depends
     on deployment order, so the scanner must report the collision rather than pick one. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Defs_notify_v1" targetNamespace="http://acme.com/claims/archive"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="customer-notification" name="Customer Notification (2019)" isExecutable="true">
    <bpmn:startEvent id="Start_Old"><bpmn:outgoing>V1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="V1" sourceRef="Start_Old" targetRef="Service_Fax" />
    <bpmn:serviceTask id="Service_Fax" name="Send fax"
                      camunda:class="com.acme.legacy.FaxDelegate">
      <bpmn:incoming>V1</bpmn:incoming>
      <bpmn:outgoing>V2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="V2" sourceRef="Service_Fax" targetRef="End_Old" />
    <bpmn:endEvent id="End_Old"><bpmn:incoming>V2</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DI_diagram_customer-notification">
    <bpmndi:BPMNPlane id="DI_plane_customer-notification" bpmnElement="customer-notification">
      <bpmndi:BPMNShape id="DI_End_Old" bpmnElement="End_Old">
        <dc:Bounds x="316" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Service_Fax" bpmnElement="Service_Fax">
        <dc:Bounds x="156" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Old" bpmnElement="Start_Old">
        <dc:Bounds x="60" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_V1" bpmnElement="V1">
        <di:waypoint x="96" y="78" />
        <di:waypoint x="126" y="78" />
        <di:waypoint x="126" y="100" />
        <di:waypoint x="156" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_V2" bpmnElement="V2">
        <di:waypoint x="256" y="100" />
        <di:waypoint x="286" y="100" />
        <di:waypoint x="286" y="78" />
        <di:waypoint x="316" y="78" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
